{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gre-learning:entry:v4",
  "title": "GRE learning entry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "word": {
      "type": "string",
      "minLength": 1
    },
    "ipa": {
      "type": "string",
      "minLength": 1
    },
    "pos": {
      "type": "string",
      "minLength": 1
    },
    "coreMeaningZh": {
      "type": "string",
      "minLength": 1
    },
    "coreEn": {
      "type": "string",
      "minLength": 1
    },
    "coreImageZh": {
      "type": "string",
      "minLength": 1
    },
    "mnemonics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "textZh": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "invented_association",
              "etymology",
              "semantic_image",
              "word_family",
              "word_components",
              "phrase_anchor"
            ]
          }
        },
        "required": [
          "method",
          "textZh",
          "original",
          "kind"
        ]
      },
      "maxItems": 3
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "senseZh": {
            "type": "string",
            "minLength": 1
          },
          "explanationZh": {
            "type": "string",
            "minLength": 1
          },
          "collocations": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "phrase": {
                  "type": "string",
                  "minLength": 1
                },
                "meaningZh": {
                  "type": "string",
                  "minLength": 1
                },
                "usageZh": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "phrase",
                "meaningZh"
              ]
            }
          }
        },
        "required": [
          "senseZh",
          "collocations"
        ]
      },
      "contains": {
        "properties": {
          "collocations": {
            "minItems": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "textEn": {
            "type": "string",
            "minLength": 1
          },
          "translationZh": {
            "type": "string",
            "minLength": 1
          },
          "explanationZh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "textEn",
          "translationZh"
        ]
      }
    },
    "equivalents": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "comparisonZh"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1
          },
          "comparisonZh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "number",
    "word",
    "ipa",
    "pos",
    "coreMeaningZh",
    "coreEn",
    "coreImageZh",
    "mnemonics",
    "usage",
    "examples",
    "equivalents"
  ],
  "anyOf": [
    {
      "properties": {
        "mnemonics": {
          "minItems": 2,
          "contains": {
            "properties": {
              "original": {
                "const": true
              }
            },
            "required": [
              "original"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "number": {
          "const": 175
        },
        "word": {
          "const": "avarice"
        },
        "mnemonics": {
          "const": [
            {
              "method": "拼写联想｜avaRICE，米仓满了还要抢",
              "textZh": "抓住词尾 RICE（米）：米商的仓库已经塞满，他还把别人待售的米袋往怀里抢，眼里想的全是钱。米越囤越多，贪心没有尽头。这里借拼写记忆；词尾读 /rɪs/。",
              "original": false,
              "kind": "invented_association"
            }
          ]
        }
      }
    },
    {
      "properties": {
        "number": {
          "const": 176
        },
        "word": {
          "const": "aver"
        },
        "mnemonics": {
          "const": [
            {
              "method": "熟词联想｜VERy sure，aVER",
              "textZh": "very 和 aver 同出表示“真实”的词根。借 very sure（非常肯定）记 aVER：别人再三追问，他依然直视对方说“我确定，就是这样”——郑重断言。",
              "original": false,
              "kind": "word_family"
            }
          ]
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "number": {
            "const": 182
          },
          "word": {
            "const": "awning"
          }
        },
        "required": [
          "number",
          "word"
        ]
      },
      "then": {
        "properties": {
          "equivalents": {
            "minItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "equivalents": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
